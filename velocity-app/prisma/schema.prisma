generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("member")
  createdAt DateTime @default(now())

  workouts Workout[]
  plans    WorkoutPlan[] @relation("CoachPlans")
  assigned WorkoutPlan[] @relation("MemberPlans")
}

model WorkoutPlan {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String
  coachId     String
  memberId    String?
  createdAt   DateTime @default(now())

  coach    User      @relation("CoachPlans", fields: [coachId], references: [id])
  member   User?     @relation("MemberPlans", fields: [memberId], references: [id])
  workouts Workout[]
}

model Workout {
  id       String   @id @default(cuid())
  title    String
  type     String
  notes    String?
  date     DateTime @default(now())
  duration Int?
  userId   String
  planId   String?

  user      User         @relation(fields: [userId], references: [id])
  plan      WorkoutPlan? @relation(fields: [planId], references: [id])
  exercises Exercise[]
}

model Exercise {
  id        String  @id @default(cuid())
  name      String
  sets      Int?
  reps      Int?
  weight    Float?
  duration  Int?
  distance  Float?
  notes     String?
  workoutId String

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}
